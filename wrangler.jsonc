{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daoncne-be",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "containers": [
    {
      "class_name": "DaonBackendContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DAON_BACKEND", "class_name": "DaonBackendContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DaonBackendContainer"] }
  ]
}
